{
  "name": "@threadsight/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./repositories": "./src/repositories/index.ts"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "pg": "^8.12.0",
    "@threadsight/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "prisma": "^7.9.0",
    "typescript": "^5.6.0",
    "vitest": "^1.5.0",
    "tsx": "^4.10.0",
    "eslint": "^8.57.0"
  }
}