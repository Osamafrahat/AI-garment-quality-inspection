# Backend (FastAPI) — copy to .env and adjust.
# All variables are optional; defaults work for local development.

# Prefix is GARMENT_ (see backend/app/config.py)
GARMENT_APP_NAME="AI Garment Quality Inspection"
GARMENT_ENVIRONMENT=development

# Comma-separated list of allowed browser origins
GARMENT_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Model artifacts (defaults point at backend/models/)
# GARMENT_MODEL_WEIGHTS=backend/models/best.pt
# GARMENT_CLASS_NAMES_PATH=backend/models/class_names.json

# Inference settings
GARMENT_INPUT_SIZE=224
# auto | cpu | cuda | mps
GARMENT_DEVICE=auto
# Predictions below this confidence are dropped
GARMENT_CONFIDENCE_THRESHOLD=0.35
# When true, the API serves deterministic demo predictions if weights are missing
GARMENT_ALLOW_DEMO_FALLBACK=true
