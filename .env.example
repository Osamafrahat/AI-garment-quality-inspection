# .env.example - Copy to .env and fill in your values

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_rental?schema=public&connection_limit=10"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/car_rental?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (NextAuth v5)
AUTH_SECRET="dev-secret-change-in-production-min-32-chars-long"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# OAuth Providers (Optional - configure for production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# File Storage (MinIO for local, S3 for production)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="car-rental"
S3_REGION="us-east-1"
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000/car-rental"

# Email (Mailpit for local dev)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@localhost"

# Push Notifications
EXPO_PUSH_TOKEN=""

# Feature Flags
ENABLE_REALTIME_GPS="false"
ENABLE_OFFLINE_MOBILE="false"