{
  "name": "car-rental",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:mobile": "turbo run build --filter=mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate --filter=db",
    "db:push": "turbo run db:push --filter=db",
    "db:migrate": "turbo run db:migrate --filter=db",
    "db:studio": "turbo run db:studio --filter=db",
    "db:seed": "turbo run db:seed --filter=db",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@turbo/gen": "^1.13.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=24.0.0"
  }
}